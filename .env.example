# Supabase Configuration
# For production: Replace with your actual Supabase project URL and Anon/Public Key
# For local testing without Supabase: Leave blank to use built-in mock/memory mode
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional service role key for admin tasks (never expose in client code)
SUPABASE_SERVICE_ROLE_KEY=
